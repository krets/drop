GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BASE_URL=https://drop.krets.com
DB_PATH=/data/app.db
SESSION_SECRET=change-me
DOMAIN=drop.krets.com
# comma-separated; each admin only sees their own shares. The first one also sees unowned audit events
ADMIN_EMAILS=you@example.com
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# optional: SMTP_FROM (defaults to SMTP_USER), SMTP_SECURITY=starttls|ssl|none, NOTIFY_EMAILS (overrides the first admin's address; others get mail at their login email)
